{
  "version": "1.0",
  "name": "Create Event",
  "template": "{\"type\":\"Card\",\"size\":\"md\",\"status\":{\"text\":{{ ((\"Order \" ~ order.id)) | tojson }},\"icon\":\"cube\"},\"children\":[{%- set _c -%},{\"type\":\"Title\",\"value\":{{ ((name ~ \" (#\" ~ number ~ \")\")) | tojson }}},{\"type\":\"Text\",\"value\":{{ ((\"$\" ~ order.total)) | tojson }}},{\"type\":\"Text\",\"value\":{{ (((items | length) ~ \" items\")) | tojson }}}{%-if flag -%},{\"type\":\"Badge\",\"label\":\"Flag\",\"color\":\"success\"}{%-else-%}{%-endif-%}{%-if not (flag) -%},{\"type\":\"Badge\",\"label\":\"NoFlag\"}{%-else-%}{%-endif-%}{%-if note -%},{\"type\":\"Text\",\"value\":{{ (note) | tojson }}}{%-else-%}{%-endif-%},{\"type\":\"Text\",\"value\":{{ (note or \"none\") | tojson }}},{\"type\":\"Text\",\"value\":{{ (note if note is defined and note is not none else \"dflt\") | tojson }}},{\"type\":\"Text\",\"value\":{% if count > 2 %}\"many\"{% else %}\"few\"{% endif %}},{\"type\":\"Text\",\"value\":{% if ((status == \"open\") and (count >= 1)) %}\"a\"{% else %}\"b\"{% endif %}},{\"type\":\"Text\",\"value\":{{ (items[0].title) | tojson }}},{\"type\":\"Text\",\"value\":{{ (order[\"id\"]) | tojson }}},{\"type\":\"Box\",\"background\":{\"light\":\"red-100\",\"dark\":\"red-900\"},\"padding\":{{ ((count * 2)) | tojson }}}{%-for item in items -%}{%-set index = loop.index0 -%},{\"type\":\"Row\",\"key\":{{ (item.id) | tojson }},\"children\":[{%- set _c -%},{\"type\":\"Caption\",\"value\":{{ (((index + 1))) | tojson }}},{\"type\":\"Text\",\"value\":{{ (item.title) | tojson }}}{%-for t in item.tags -%},{\"type\":\"Badge\",\"key\":{{ (t) | tojson }},\"label\":{{ (t) | tojson }}}{%-endfor-%}{%- endset -%}{{- (_c[1:] if _c and _c[0] == ',' else _c) -}}]}{%-endfor-%},{\"type\":\"Button\",\"label\":\"Go\",\"onClickAction\":{\"type\":\"order.view\",\"payload\":{\"id\":{{ (order.id) | tojson }},\"n\":{{ (count) | tojson }}}}}{%- endset -%}{{- (_c[1:] if _c and _c[0] == ',' else _c) -}}]}",
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "number": {
        "type": "number"
      },
      "order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "total"
        ],
        "additionalProperties": false
      },
      "count": {
        "type": "number"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "title",
            "tags"
          ],
          "additionalProperties": false
        }
      },
      "flag": {
        "type": "boolean"
      },
      "note": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    },
    "required": [
      "name",
      "number",
      "order",
      "count",
      "items",
      "flag",
      "note",
      "status"
    ],
    "additionalProperties": false
  },
  "outputJsonPreview": {
    "type": "Card",
    "size": "md",
    "status": {
      "text": "Order A1",
      "icon": "cube"
    },
    "children": [
      {
        "type": "Title",
        "value": "Ann (#7)"
      },
      {
        "type": "Text",
        "value": "$12.5"
      },
      {
        "type": "Text",
        "value": "1 items"
      },
      {
        "type": "Badge",
        "label": "Flag",
        "color": "success"
      },
      {
        "type": "Text",
        "value": "hi"
      },
      {
        "type": "Text",
        "value": "hi"
      },
      {
        "type": "Text",
        "value": "hi"
      },
      {
        "type": "Text",
        "value": "many"
      },
      {
        "type": "Text",
        "value": "a"
      },
      {
        "type": "Text",
        "value": "T"
      },
      {
        "type": "Text",
        "value": "A1"
      },
      {
        "type": "Box",
        "background": {
          "light": "red-100",
          "dark": "red-900"
        },
        "padding": 6
      },
      {
        "type": "Row",
        "key": "x",
        "children": [
          {
            "type": "Caption",
            "value": "1"
          },
          {
            "type": "Text",
            "value": "T"
          },
          {
            "type": "Badge",
            "key": "a",
            "label": "a"
          },
          {
            "type": "Badge",
            "key": "b",
            "label": "b"
          }
        ]
      },
      {
        "type": "Button",
        "label": "Go",
        "onClickAction": {
          "type": "order.view",
          "payload": {
            "id": "A1",
            "n": 3
          }
        }
      }
    ]
  },
